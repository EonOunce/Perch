{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perch",
  "version": "0.0.1",
  "identifier": "com.perch.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PerchLayerProbe",
        "url": "index.html",
        "width": 360,
        "height": 480,
        "x": 80,
        "y": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
